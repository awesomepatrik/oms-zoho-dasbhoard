# Zoho Dashboard — root-level access controls

Options -Indexes

# Block all access to the config directory (credentials + tokens).
RewriteEngine On
RewriteRule ^zoho-dashboard-config(/|$) - [F,L]

# Block access to git metadata.
RewriteRule ^\.git(/|$) - [F,L]

# Block direct access to PHP files in config dir (belt-and-suspenders).
<FilesMatch "^(config|tokens)(\..+)?$">
    <If "%{REQUEST_URI} =~ m|/zoho-dashboard-config/|">
        Require all denied
    </If>
</FilesMatch>

# Block access to temporary and editor files everywhere.
<FilesMatch "\.(tmp|bak|swp|orig|DS_Store)$">
    Require all denied
</FilesMatch>

# Force UTF-8 for all responses.
AddDefaultCharset UTF-8
